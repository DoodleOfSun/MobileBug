<?xml version="1.0" encoding="utf-8"?>
<!-- 레벨업 선택창 (settings.xml 과 같은 군사 테마). 코드에서 쓰는 id: text_choose1~3, btn_choose1~3 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="550dp"
    android:layout_height="330dp"
    android:background="@android:color/transparent">

    <!-- 테두리 패널 (settings.xml 과 동일, 그림 비율 872:592 유지) -->
    <ImageView
        android:id="@+id/levelUpPanel"
        android:layout_width="0dp"
        android:layout_height="320dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/settings_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="872:592"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 제목 뒤 비스듬한 띠 -->
    <ImageView
        android:id="@+id/levelUpTitleBand"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/settings_title_band"
        app:layout_constraintStart_toStartOf="@id/levelUpPanel"
        app:layout_constraintTop_toTopOf="@id/levelUpPanel" />

    <!-- 노란 빗금 장식 -->
    <ImageView
        android:id="@+id/levelUpStripes"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginStart="12dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/settings_stripes"
        app:layout_constraintBottom_toBottomOf="@id/levelUpTitleBand"
        app:layout_constraintStart_toStartOf="@id/levelUpTitleBand"
        app:layout_constraintTop_toTopOf="@id/levelUpTitleBand" />

    <!-- LEVEL UP 글자 (패널 가로 가운데) -->
    <TextView
        android:id="@+id/levelUpTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/youre_gone"
        android:includeFontPadding="false"
        android:shadowColor="#3C4232"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="3"
        android:text="LEVEL UP"
        android:textColor="#E3D5B5"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@id/levelUpTitleBand"
        app:layout_constraintEnd_toEndOf="@id/levelUpPanel"
        app:layout_constraintStart_toStartOf="@id/levelUpPanel"
        app:layout_constraintTop_toTopOf="@id/levelUpTitleBand" />

    <!-- 구분선 -->
    <ImageView
        android:id="@+id/levelUpDivider"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="28dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/settings_divider"
        app:layout_constraintEnd_toEndOf="@id/levelUpPanel"
        app:layout_constraintStart_toStartOf="@id/levelUpPanel"
        app:layout_constraintTop_toBottomOf="@id/levelUpTitleBand" />

    <!-- 선택지 3개 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/levelUpPanel"
        app:layout_constraintEnd_toEndOf="@id/levelUpPanel"
        app:layout_constraintStart_toStartOf="@id/levelUpPanel"
        app:layout_constraintTop_toBottomOf="@id/levelUpDivider">

        <!-- 1번 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_choose1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:shadowColor="#3C4232"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:text="강화 1"
                android:textColor="#E3D5B5"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 검은 아이콘이 어두운 패널에서 보이도록 글자색으로 칠함 -->
            <ImageButton
                android:id="@+id/btn_choose1"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@android:color/transparent"
                android:contentDescription="선택1"
                android:scaleType="fitCenter"
                android:src="@drawable/xmark512"
                app:tint="#E3D5B5" />
        </LinearLayout>

        <!-- 2번 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_choose2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:shadowColor="#3C4232"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:text="강화 2"
                android:textColor="#E3D5B5"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_choose2"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@android:color/transparent"
                android:contentDescription="선택2"
                android:scaleType="fitCenter"
                android:src="@drawable/xmark512"
                app:tint="#E3D5B5" />
        </LinearLayout>

        <!-- 3번 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_choose3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:shadowColor="#3C4232"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:text="강화 3"
                android:textColor="#E3D5B5"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_choose3"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@android:color/transparent"
                android:contentDescription="선택3"
                android:scaleType="fitCenter"
                android:src="@drawable/xmark512"
                app:tint="#E3D5B5" />
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>